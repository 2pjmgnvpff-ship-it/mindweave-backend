# ============================================================================
# MindWeave (心络) Backend Environment Configuration Example
# Copy to `.env` for local development. NEVER commit real secrets or `.env`!
# ============================================================================

MINDWEAVE_ENVIRONMENT=dev
MINDWEAVE_SERVICE_NAME=mindweave-backend
MINDWEAVE_API_PREFIX=/v1
MINDWEAVE_DEBUG=false

# ----------------------------------------------------------------------------
# PostgreSQL 16 Connection Pools (Invariant I1)
# - APP_DATABASE_URL MUST use a NOBYPASSRLS role (`mindweave_app`)
# - SYSTEM_DATABASE_URL uses BYPASSRLS role ONLY for auth bootstrap & queue
# - MIGRATION_DATABASE_URL uses table owner role (`mindweave_owner`) for DDL
# ----------------------------------------------------------------------------
MINDWEAVE_APP_DATABASE_URL=postgresql+asyncpg://mindweave_app:mindweave_app@127.0.0.1:55432/mindweave
MINDWEAVE_SYSTEM_DATABASE_URL=postgresql+asyncpg://mindweave_system:mindweave_system@127.0.0.1:55432/mindweave
MINDWEAVE_MIGRATION_DATABASE_URL=postgresql+asyncpg://mindweave_owner:mindweave_owner@127.0.0.1:55432/mindweave

# ----------------------------------------------------------------------------
# Envelope Encryption & Step-Up Authentication (Invariants I8, I12)
# Generate KEK in prod via: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------------------------
MINDWEAVE_KEK_ID=kek-local-v1
MINDWEAVE_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MINDWEAVE_DEK_CACHE_TTL_SECONDS=300
MINDWEAVE_DEK_CACHE_MAX_ENTRIES=2048

MINDWEAVE_JWT_SECRET=mindweave-dev-jwt-secret-change-in-production-32bytes!
MINDWEAVE_JWT_ISSUER=mindweave
MINDWEAVE_ACCESS_TOKEN_TTL_SECONDS=900
MINDWEAVE_REAUTH_TOKEN_TTL_SECONDS=300
MINDWEAVE_REFRESH_TOKEN_TTL_DAYS=30
MINDWEAVE_OTP_TTL_SECONDS=600
MINDWEAVE_OTP_MAX_ATTEMPTS=5
MINDWEAVE_ALLOW_DEV_MOCK_APPLE_AUTH=true
MINDWEAVE_EXPOSE_DEV_OTP_IN_RESPONSE=false

# ----------------------------------------------------------------------------
# Encrypted Media Storage
# ----------------------------------------------------------------------------
MINDWEAVE_BLOB_STORAGE_DIR=.data/blobs
MINDWEAVE_EPHEMERAL_SCREENSHOT_BY_DEFAULT=true
MINDWEAVE_MAX_AUDIO_BYTES=10485760
MINDWEAVE_MAX_AUDIO_DURATION_SEC=120
MINDWEAVE_MAX_IMAGE_BYTES=10485760

# ----------------------------------------------------------------------------
# AI Model Gateway (M0-M5: `fake` or paid-tier `gemini`; M6 `prod_cn`: domestic filed models ONLY)
# ----------------------------------------------------------------------------
MINDWEAVE_AI_PRIMARY_PROVIDER=fake
MINDWEAVE_AI_FALLBACK_PROVIDER=none

# Paid-tier Gemini (strictly internal self-test / synthetic data in M0-M5; blocked in `prod_cn`)
MINDWEAVE_GEMINI_API_KEY=
MINDWEAVE_GEMINI_MODEL_FAST=gemini-2.5-flash
MINDWEAVE_GEMINI_MODEL_CHAT=gemini-2.5-flash
MINDWEAVE_GEMINI_PAID_TIER_ACKNOWLEDGED=false

# M6 Mainland China Filed Model Providers (DashScope Qwen / Volcengine Ark Doubao / DeepSeek-V3)
MINDWEAVE_DASHSCOPE_API_KEY=
MINDWEAVE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINDWEAVE_DASHSCOPE_EXTRACT_MODEL=qwen-plus
MINDWEAVE_DASHSCOPE_VISION_MODEL=qwen-vl-max

MINDWEAVE_ARK_API_KEY=
MINDWEAVE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MINDWEAVE_ARK_CHAT_MODEL=doubao-1-5-pro-32k

MINDWEAVE_DEEPSEEK_API_KEY=
MINDWEAVE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# NOTE: `deepseek-reasoner` / R1 is forbidden due to companion streaming TTFT latency!
MINDWEAVE_DEEPSEEK_CHAT_MODEL=deepseek-chat

MINDWEAVE_AI_TIMEOUT_SECONDS=18.0
MINDWEAVE_SAFETY_TIMEOUT_SECONDS=5.0

# ----------------------------------------------------------------------------
# Domain Policies, Quotas & Anti-Addiction Care
# ----------------------------------------------------------------------------
MINDWEAVE_GATE_CONFIDENCE_THRESHOLD=0.80
MINDWEAVE_UNDO_WINDOW_SECONDS=5
MINDWEAVE_VENTING_HOLD_EXPIRY_HOURS=72
MINDWEAVE_SOFT_DELETE_RETENTION_DAYS=30
MINDWEAVE_EXPORT_DOWNLOAD_TTL_HOURS=24
MINDWEAVE_DAILY_CHAT_QUOTA=100
MINDWEAVE_DAILY_VOICE_MINUTES_QUOTA=60
MINDWEAVE_LATE_NIGHT_START_HOUR=0
MINDWEAVE_LATE_NIGHT_END_HOUR=5
MINDWEAVE_LATE_NIGHT_CONTINUOUS_MINUTES=45
MINDWEAVE_DEFAULT_TIMEZONE=Asia/Shanghai

# CORS
MINDWEAVE_CORS_ORIGINS=["http://127.0.0.1:8790","http://localhost:8790"]
